{
  "name": "dakinis-streamautomator",
  "private": true,
  "version": "2.3.1",
  "description": "StreamAutomator - apps/api (Express), apps/web (React)",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:api": "npm run dev -w streamautomator-api",
    "dev:web": "npm run dev -w streamautomator-web",
    "start:api": "npm run start -w streamautomator-api",
    "build:web": "npm run build -w streamautomator-web",
    "test:api": "npm run test -w streamautomator-api",
    "test:web": "npm run test -w streamautomator-web"
  }
}
