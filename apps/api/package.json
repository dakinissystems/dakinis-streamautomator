{
  "name": "streamautomator-api",
  "version": "2.4.0",
  "main": "src/apiServer.js",
  "type": "module",
  "scripts": {
    "start": "node src/apiServer.js",
    "start:render": "node --experimental-wasm-threads src/apiServer.js",
    "dev": "nodemon src/apiServer.js",
