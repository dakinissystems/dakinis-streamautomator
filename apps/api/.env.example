# Copiar a apps/api/.env — no commitear secretos

# Sentry
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Stripe legacy SA (opcional tras billing unificado greenfield)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Billing unificado (Fase 1.2) — requerido con flag billing.unified ON
DAKINIS_INTERNAL_SERVICE_KEY=
DAKINIS_INTERNAL_URL=https://api.dakinissystems.com/internal
# Fuerza cutover sin esperar cache de flags (greenfield)
BILLING_UNIFIED=true
# Dual-write shadow sin flag (dev/smoke)
# BILLING_UNIFIED_SHADOW_SYNC=true

# Database
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
