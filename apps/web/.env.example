# Frontend Environment Variables
# For local development: Copy this file to .env and configure
# For Render: Set these as Environment Variables in the Render dashboard

# Backend API URL (VITE_* preferred; REACT_APP_* still works via Vite shim)
# Local development: http://localhost:4002
# Production: https://api.streamautomator.com
VITE_API_URL=http://localhost:4002
# Legacy name still supported:
# REACT_APP_API_URL=http://localhost:4002

# Optional: same as REACT_APP_API_URL; used for Twitch OAuth redirect. If unset, REACT_APP_API_URL is used.
# REACT_APP_BACKEND_URL=https://api.streamautomator.com

# Supabase Configuration (for file uploads)
# Get these from: https://app.supabase.com â†’ Project Settings â†’ API
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here
# For OAuth (Twitter/Google/Twitch): Supabase Dashboard -> Authentication -> URL Configuration: add /auth/callback to Redirect URLs; set Site URL to your app origin.

# Optional: Show "Install app" (PWA) button in header. Set to true to allow users to install the app.
# REACT_APP_SHOW_PWA_INSTALL=true

# Optional: Banners below the header (StreamAutomator / User / EN/ES / Logout). JSON array; each item:
#   id (optional), text, textEs (optional, for Spanish), url (optional), style: info|warning|success|neutral, dismissible (optional)
# Example (single line, escape quotes in .env):
# REACT_APP_HEADER_BANNERS=[{"id":"1","text":"Welcome!","textEs":"Bienvenido","style":"info","dismissible":true},{"text":"Maintenance on Sunday","textEs":"Mantenimiento el domingo","style":"warning","url":"https://example.com"}]

# Note: All React environment variables MUST start with REACT_APP_
# Variables without this prefix will be ignored by React

# Optional: set to true to disable ESLint during build (if you see "defaultMeta" compile error)
# DISABLE_ESLINT_PLUGIN=true
